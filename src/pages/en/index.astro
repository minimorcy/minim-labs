---
import Layout from "../../layouts/Layout.astro";
import AppCard from "../../components/AppCard.astro";
import { apps } from "../../data/apps";
import { useTranslations } from "../../i18n/utils";

const lang = "en" as const;
const t = useTranslations(lang);
---

<Layout title="minim-labs — Application hub" description={t("site.description")} lang={lang}>
	<main class="mx-auto flex min-h-screen max-w-5xl flex-col px-6 pb-16 pt-10 sm:pb-24">
		<header class="mb-16">
			<p id="nickname" class="text-[50px] font-bold lg:text-[100px]">&lt;MînîM /&gt;</p>
			<p class="mt-2 font-mono text-sm text-neutral-500">minim-labs.dev</p>
			<h1 class="mt-3 text-3xl font-semibold tracking-tight text-neutral-100 sm:text-4xl">
				{t("hub.title")}
			</h1>
			<p class="mt-4 max-w-xl text-neutral-400">
				{t("hub.subtitle")}
			</p>
		</header>

		<section class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{apps.map((app) => <AppCard app={app} lang={lang} />)}
		</section>

		<footer class="mt-24 border-t border-neutral-900 pt-6 text-xs text-neutral-600">
			<p>&copy; {new Date().getFullYear()} minim-labs</p>
		</footer>
	</main>
</Layout>
