---
import Layout from "../layouts/Layout.astro";
import AppCard from "../components/AppCard.astro";
import { apps } from "../data/apps";
---

<Layout title="minim-labs — Hub de aplicaciones">
	<main class="mx-auto flex min-h-screen max-w-5xl flex-col px-6 py-16 sm:py-24">
		<header class="mb-16">
			<p class="font-mono text-sm text-neutral-500">minim-labs.dev</p>
			<h1 class="mt-3 text-3xl font-semibold tracking-tight text-neutral-100 sm:text-4xl">
				Hub de aplicaciones
			</h1>
			<p class="mt-4 max-w-xl text-neutral-400">
				Punto de entrada a los proyectos alojados bajo subdominios de minim-labs.dev.
			</p>
		</header>

		<section class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{apps.map((app) => <AppCard app={app} />)}
		</section>

		<footer class="mt-24 border-t border-neutral-900 pt-6 text-xs text-neutral-600">
			<p>&copy; {new Date().getFullYear()} minim-labs</p>
		</footer>
	</main>
</Layout>
